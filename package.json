{
  "name": "agent-file-optimizer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "deploy:dry": "wrangler deploy --dry-run",
    "site:check": "node scripts/check-site.mjs",
    "site:preview": "python3 -m http.server 8788 --directory site --bind 127.0.0.1"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "wrangler": "4.131.1"
  },
  "dependencies": {
    "fflate": "0.8.3"
  },
  "license": "Apache-2.0",
  "description": "A self-hosted temporary workspace that turns files into a clear handoff for AI agents and people."
}
