{
  "name": "agent-file-optimizer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "deploy:dry": "wrangler deploy --dry-run",
    "deploy": "node scripts/deploy.mjs",
    "smoke": "node scripts/smoke.mjs",
    "site:build": "node site-src/tools/build.mjs",
    "site:test": "node --test 'site-src/tests/*.test.mjs'",
    "site:check": "node scripts/check-site.mjs",
    "site:preview": "node site-src/tools/serve.mjs 8788",
    "browser-check": "node scripts/browser-check.mjs",
    "og": "node scripts/og-image.mjs",
    "health": "node scripts/health-check.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "26.5.1",
    "playwright-core": "^1.64.1",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "wrangler": "4.131.1"
  },
  "dependencies": {
    "fflate": "0.8.3"
  },
  "license": "Apache-2.0",
  "description": "A self-hosted temporary workspace that turns files into a clear handoff for AI agents and people.",
  "cloudflare": {
    "bindings": {
      "ADMIN_TOKEN": {
        "description": "A long random value. Anyone who sends it can create workspaces on your account. Generate one with: openssl rand -base64 32"
      }
    }
  }
}
