{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-file-optimizer",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  // Request logs and traces record the full URL, and a share link carries its token in the path.
  // So per-request logging is off. The app's own log lines (route class and error name only) stay on.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": false
    }
  },
  // No resource IDs here on purpose. Wrangler creates the bucket and database on the first
  // `wrangler deploy` (or `wrangler dev`) and writes their IDs back, so each copy gets its own.
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "agent-file-optimizer-files"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-file-optimizer",
      "migrations_dir": "migrations"
    }
  ],
  // About 120 requests a minute per caller address and route class (share reads, API calls). Cloudflare's limiter is approximate, so this is a brake on floods, not an exact cap.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
